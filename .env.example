# 로컬 실행용: 이 파일을 .env.local 로 복사해서 값을 채우세요 (.env.local은 커밋하지 마세요)
# 둘 다 비워두면 샘플 데이터로 동작합니다.

# 실시간 가격 (Google 항공권, https://serpapi.com/manage-api-key) — 특정일 검색에 사용
SERPAPI_KEY=
# "한 달" 검색에서 캐시 가격이 적을 때 실시간으로 채울 날짜 수 (날짜 1개 = 크레딧 1개, 0이면 끔)
# SERPAPI_MONTH_SAMPLES=6

# 수집된(캐시) 가격 (Travelpayouts) — "한 달" 검색, SERPAPI_KEY가 없을 때 사용
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
